<Application x:Class="PrototypeRadioReceiverSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Палитра (по умолчанию — светлая тема) -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F5EDF0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#DCBDDF"/>
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#9A99E1"/>
        <SolidColorBrush x:Key="PrimaryButtonFgBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#008BD0"/>
        <SolidColorBrush x:Key="AccentButtonFgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextBrush" Color="#3A2B45"/>
        <!-- Цвета вкладок -->
        <SolidColorBrush x:Key="TabActiveBrush" Color="#008BD0"/>
        <SolidColorBrush x:Key="TabInactiveBrush" Color="#8A8A8A"/>
        <!-- ComboBox -->
        <SolidColorBrush x:Key="ComboBoxBgBrush" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#F5EDF0"/>
        <SolidColorBrush x:Key="ComboBoxFgBrush" Color="#333333"/>
        <!-- Обводка кнопок -->
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#000000"/>
        <!-- Карточки (для избранного и журнала) -->
        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#999999"/>
        <SolidColorBrush x:Key="CardHeaderBrush" Color="#9A99E1"/>
        <SolidColorBrush x:Key="CardHeaderFgBrush" Color="White"/>
        <!-- Тема меняется на тёмную из кода MainWindow -->

        <!-- Шрифт по умолчанию для всех элементов управления -->
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Montserrat Alternates"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Круглая/скруглённая кнопка с обводкой -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-крестик закрытия -->
        <Style x:Key="CloseCrossButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Montserrat Alternates"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C05050"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Скруглённый ComboBox -->
        <Style x:Key="RoundComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Montserrat Alternates"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboBoxFgBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{DynamicResource ComboBoxBgBrush}"
                                                BorderBrush="{DynamicResource ComboBoxBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Fill="{DynamicResource ComboBoxFgBrush}"
                                                  Data="M 0 0 L 8 0 L 4 4 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#008BD0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource ComboBoxBgBrush}"
                                        BorderBrush="{DynamicResource ComboBoxBorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
