<Window x:Class="PrototypeRadioReceiverSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Радиоприёмник TEA5767"
        Width="600" Height="481"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Montserrat Alternates"
        FontSize="14"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBgBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Border x:Name="HeaderBorder" Grid.Row="0"
                    Background="{DynamicResource PanelBrush}" CornerRadius="12,12,0,0">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <!-- Текст по центру с отступом справа 63 -->
                    <TextBlock Text="Радиоприёмник TEA5767"
                               FontSize="20" FontWeight="Bold"
                               x:Name="HeaderTextBlock"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,63,0"/>

                    <!-- Иконка темы: расстояние 15px от крестика закрытия -->
                    <Button x:Name="ThemeButton" Content="🌙"
                            Width="40" Height="40"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,53,0"
                            FontSize="32" FontWeight="Normal"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="ThemeButton_Click"
                            Foreground="#FFD700"/>

                    <!-- Кнопка закрыть -->
                    <Button x:Name="CloseButton" Content="✕"
                            Style="{StaticResource CloseCrossButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Margin="0">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">

                    <!-- Частота -->
                    <TextBlock x:Name="FrequencyTextBlock"
                               Text="101.5 МГц"
                               FontSize="48" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,33,0,0"/>

                    <!-- Уровень сигнала -->
                    <TextBlock x:Name="SignalTextBlock"
                               Text="Уровень сигнала: 8/10 Стерео"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                    <!-- Ряд 4 кнопок: внутри группы 50, между группами 60 -->
                    <Grid Margin="20,35,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="FreqUpButton"
                                Content="Частота +"
                                Style="{StaticResource RoundButton}"
                                Width="100" Height="40" Padding="0"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Click="FreqUpButton_Click"/>

                        <Button Grid.Column="2" x:Name="FreqDownButton"
                                Content="Частота -"
                                Style="{StaticResource RoundButton}"
                                Width="100" Height="40" Padding="0"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Click="FreqDownButton_Click"/>

                        <Button Grid.Column="4" x:Name="ScanButton"
                                Content="Поиск"
                                Style="{StaticResource RoundButton}"
                                Width="100" Height="40" Padding="0"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Click="ScanButton_Click"/>

                        <Button Grid.Column="6" x:Name="SaveButton"
                                Content="Сохранить"
                                Style="{StaticResource RoundButton}"
                                Width="100" Height="40" Padding="0"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Click="SaveButton_Click"/>
                    </Grid>

                    <!-- Ряд 2 кнопок: расстояние 104 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,70,0,0">
                        <Button x:Name="FavoritesButton" Content="Избранное"
                                Style="{StaticResource RoundButton}"
                                Width="150" Height="40"
                                FontSize="18" FontWeight="SemiBold"
                                Background="{DynamicResource PanelBrush}"
                                Foreground="{DynamicResource TextBrush}"
                                BorderThickness="0"
                                Margin="0,0,104,0"
                                Click="FavoritesButton_Click"/>

                        <Button x:Name="LogButton" Content="Журнал операций"
                                Style="{StaticResource RoundButton}"
                                Width="220" Height="40"
                                FontSize="18" FontWeight="SemiBold"
                                Background="{DynamicResource PanelBrush}"
                                Foreground="{DynamicResource TextBrush}"
                                BorderThickness="0"
                                Click="LogButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <!-- НИЖНЯЯ ПАНЕЛЬ -->
            <Border x:Name="BottomBorder" Grid.Row="2"
                    Background="{DynamicResource PanelBrush}" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="137"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- COM-порт -->
                    <TextBlock Grid.Column="0" Text="COM-порт:"
                               FontSize="20" FontWeight="Bold"
                               x:Name="ComPortLabel"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="24,0,10,0"/>

                    <!-- ComboBox: минимальная ширина, цвета меняются по теме -->
                    <ComboBox Grid.Column="1" x:Name="PortComboBox"
                              Style="{StaticResource RoundComboBox}"
                              Width="100" Height="30"
                              VerticalAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="COM1"/>
                        <ComboBoxItem Content="COM2"/>
                        <ComboBoxItem Content="COM3"/>
                        <ComboBoxItem Content="COM4"/>
                    </ComboBox>

                    <!-- Кнопка подключения: 150x30, белый жирный текст, без обводки -->
                    <Button Grid.Column="3" x:Name="ConnectButton"
                            Content="Подключиться"
                            Style="{StaticResource RoundButton}"
                            Width="150" Height="30" Padding="0"
                            FontSize="16" FontWeight="Bold"
                            Foreground="White"
                            BorderThickness="0"
                            Background="{DynamicResource AccentBrush}"
                            Click="ConnectButton_Click"/>

                    <!-- Кружок статуса: справа от кнопки, отступ 17 -->
                    <Ellipse Grid.Column="4" x:Name="StatusIndicator"
                             Width="20" Height="20"
                             VerticalAlignment="Center"
                             Margin="17,0,25,0"
                             Fill="#9E9E9E"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
