<Window x:Class="PrototypeRadioReceiverSystem.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Журнал операций"
        Width="600" Height="367"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="Montserrat Alternates"
        FontSize="14"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Шаблон карточки журнала -->
        <DataTemplate x:Key="LogCardTemplate">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="0"
                    Width="555" Height="30" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Date}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Time}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Event}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Шапка карточки журнала -->
        <DataTemplate x:Key="LogCardHeaderTemplate">
            <Border Background="{DynamicResource CardHeaderBrush}"
                    Width="555" Height="28" CornerRadius="0" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Дата"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Время"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Событие"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Стиль ListBoxItem: без рамки -->
        <Style x:Key="NoBorderListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4.5,0,4.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна: без скруглений, без крестика -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    CornerRadius="0">
                <TextBlock Text="Журнал операций"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Border>

            <!-- Вкладки -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Button x:Name="ActionsTab" Content="Действия"
                        Foreground="{DynamicResource TabActiveBrush}"
                        Background="Transparent" BorderThickness="0"
                        Padding="10,4" Cursor="Hand"
                        FontSize="20"
                        HorizontalAlignment="Left"
                        Margin="112,0,0,0"
                        Click="ActionsTab_Click"/>
                <!-- Разделительная черта по центру -->
                <Rectangle Width="1" Height="33" Fill="#999999"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="ErrorsTab" Content="Ошибки"
                        Foreground="#8A8A8A"
                        Background="Transparent" BorderThickness="0"
                        Padding="10,4" Cursor="Hand"
                        FontSize="20"
                        HorizontalAlignment="Right"
                        Margin="0,0,112,0"
                        Click="ErrorsTab_Click"/>
            </Grid>

            <!-- Карточки -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                <!-- Шапка таблицы -->
                <ContentControl ContentTemplate="{StaticResource LogCardHeaderTemplate}"
                                HorizontalAlignment="Center"/>
                <!-- Список карточек -->
                <ListBox x:Name="LogListBox"
                         ItemTemplate="{StaticResource LogCardTemplate}"
                         ItemContainerStyle="{StaticResource NoBorderListBoxItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,42,0,20">

                <Button x:Name="ClearButton" Content="Очистить"
                        Style="{StaticResource RoundButton}"
                        Width="116" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentButtonFgBrush}"
                        BorderThickness="0"
                        Margin="0,0,30,0"
                        Click="ClearButton_Click"/>

                <Button x:Name="SaveButton" Content="Сохранить в файл"
                        Style="{StaticResource RoundButton}"
                        Width="230" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource PrimaryButtonBrush}"
                        BorderThickness="0"
                        Margin="0,0,30,0"
                        Click="SaveButton_Click"/>

                <Button x:Name="CloseBtn" Content="Закрыть"
                        Style="{StaticResource RoundButton}"
                        Width="116" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource PanelBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,30,0"
                        Click="CloseBtn_Click"/>
            </StackPanel>

            <!-- Toast-уведомления -->
            <StackPanel x:Name="ToastPanel"
                        Grid.RowSpan="4"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10"
                        Panel.ZIndex="100"/>
        </Grid>
    </Border>
</Window>
