<Window x:Class="PrototypeRadioReceiverSystem.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Избранное"
        Width="600" Height="367"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Montserrat Alternates"
        FontSize="14"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Стиль ячеек DataGrid: шрифт 20 Medium -->
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Montserrat Alternates"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellLeft" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="CellCenter" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellRight" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Шапка таблицы -->
        <Style x:Key="HeaderLeft" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="Montserrat Alternates"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="HeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Строка: отступ 9 между строками, серая обводка снаружи -->
        <Style x:Key="FavoriteRowStyle" TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,4.5,0,4.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border BorderBrush="#999999" BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter x:Name="PART_DataGridCellsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Избранные станции"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   HorizontalAlignment="Left"
                   Margin="22,18,0,0"/>

        <!-- Таблица -->
        <DataGrid Grid.Row="1" x:Name="FavoritesGrid"
                  Margin="0,23,0,0"
                  Width="555" HorizontalAlignment="Center"
                  RowHeight="30"
                  RowStyle="{StaticResource FavoriteRowStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  Background="Transparent"
                  RowBackground="Transparent"
                  Foreground="{DynamicResource TextBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Частота" Binding="{Binding Frequency}" Width="120"
                                    HeaderStyle="{StaticResource HeaderLeft}"
                                    ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"
                                    HeaderStyle="{StaticResource HeaderCenter}"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="120"
                                    HeaderStyle="{StaticResource HeaderRight}"
                                    ElementStyle="{StaticResource CellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,42,0,20">

            <Button x:Name="SelectButton" Content="Выбрать"
                    Style="{StaticResource RoundButton}"
                    MinWidth="46" Height="40" Padding="12,0"
                    FontSize="20"
                    Background="{DynamicResource PrimaryButtonBrush}"
                    Margin="0,0,87,0"
                    Click="SelectButton_Click"/>

            <Button x:Name="DeleteButton" Content="Удалить"
                    Style="{StaticResource RoundButton}"
                    MinWidth="46" Height="40" Padding="12,0"
                    FontSize="20"
                    Background="{DynamicResource PrimaryButtonBrush}"
                    Margin="0,0,87,0"
                    Click="DeleteButton_Click"/>

            <Button x:Name="CloseButton" Content="Закрыть"
                    Style="{StaticResource RoundButton}"
                    MinWidth="46" Height="40" Padding="12,0"
                    FontSize="20"
                    Background="{DynamicResource PrimaryButtonBrush}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
