<Window x:Class="PrototypeRadioReceiverSystem.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Избранное"
        Width="600" Height="367"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="Montserrat Alternates"
        FontSize="14"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Шаблон карточки -->
        <DataTemplate x:Key="FavoriteCardTemplate">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="0"
                    Width="555" Height="30" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Frequency}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Date}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Шапка карточки -->
        <DataTemplate x:Key="CardHeaderTemplate">
            <Border Background="{DynamicResource CardHeaderBrush}"
                    Width="555" Height="28" CornerRadius="0" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Частота"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Название"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Дата"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource CardHeaderFgBrush}"
                               HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Стиль ListBoxItem: без рамки -->
        <Style x:Key="NoBorderListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4.5,0,4.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна: без скруглений, без крестика -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    CornerRadius="0">
                <TextBlock Text="Избранные станции"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Border>

            <!-- Карточки -->
            <StackPanel Grid.Row="1" Margin="0,23,0,0"
                        HorizontalAlignment="Center">

                <!-- Шапка таблицы -->
                <ContentControl ContentTemplate="{StaticResource CardHeaderTemplate}"
                                HorizontalAlignment="Center"/>

                <!-- Список карточек -->
                <ListBox x:Name="FavoritesListBox"
                         ItemTemplate="{StaticResource FavoriteCardTemplate}"
                         ItemContainerStyle="{StaticResource NoBorderListBoxItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,42,0,20">

                <Button x:Name="SelectButton" Content="Выбрать"
                        Style="{StaticResource RoundButton}"
                        Width="116" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentButtonFgBrush}"
                        BorderThickness="0"
                        Margin="0,0,87,0"
                        Click="SelectButton_Click"/>

                <Button x:Name="DeleteButton" Content="Удалить"
                        Style="{StaticResource RoundButton}"
                        Width="116" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource PrimaryButtonBrush}"
                        BorderThickness="0"
                        Margin="0,0,87,0"
                        Click="DeleteButton_Click"/>

                <Button x:Name="CloseBtn" Content="Закрыть"
                        Style="{StaticResource RoundButton}"
                        Width="116" Height="40" Padding="0"
                        FontSize="18"
                        Background="{DynamicResource PanelBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
